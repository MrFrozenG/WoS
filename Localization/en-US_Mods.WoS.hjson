Configs: {
	MainConfig: {
		DisplayName: "[WoS] Content Config"

		Headers: {
			Weapons: Weapons
			QoL: QoL
			QoL_ModCompatibility: QoL (Mod Compatibility)
		}

		SkyFractureCelestialBlessing: {
			Label: "[i:3787] Sky Fracture: Celestial Blades"
			Tooltip:
				'''
				Sky Fracture has a 25% chance, or always on critical hits, to spawn a Celestial Blade.
				 
				Each active Celestial Blade increases:
				• Magic damage by 2%
				• Sky Fracture damage by 4%

				{$Controls.RightClick}
				Recall all Celestial Blades to the cursor position.
				Enter Burst mode: Sky Bless

				If this config is disabled:
				The effect becomes available after defeating Golem.
				'''
		}

		ExplosivesAutouse: {
			Label: "[i:168] Explosives: Auto-use"
			Tooltip: If enabled, it allows to use an auto-throw for Explosives.
		}

		ExplosivesThrowSpeed: {
			Label: "[i:168] Explosives: Throwing speed"
			Tooltip: Changes the throwing speed of explosives. Default: 25
		}

		ThrowingWeaponsAutouse: {
			Label: "[i:279] Throwing weapons: Auto-use"
			Tooltip: If enabled, it allows to use an auto-throw for some throwing weapons.
		}

		ThrowingWeaponsSpeed: {
			Label: "[i:279] Throwing Weapons Speed"
			Tooltip: Changes the throwing speed of some throwing weapons. Default: 15
		}

		IceSickleDeepCold: {
			Label: "[i:1306] Ice Sickle: Deep Cold"
			Tooltip:
				'''
				Ice Sickle spins continuously while held.

				While spinning:
				• Periodically fires Ice Slashes in random directions
				• Ice Slashes have a chance to call down Ice Shards from the sky on hit
				• Ice Shards deal additional damage

				If this config is disabled:
				The effect becomes available after entering Hardmode.
				'''
		}

		MeteorStaffNoCeiling: {
			Label: "[i:2750] Meteor Staff: No Ceiling"
			Tooltip: Meteors ignore blocks while falling above or at the player's height
		}

		StarfuryNoCeiling: {
			Label: "[i:65] Starfury: No Ceiling"
			Tooltip: Falling stars ignore blocks while falling above or at the player's height
		}

		BlizzardStaffNoCeiling: {
			Label: "[i:1931] Blizzard Staff: No Ceiling"
			Tooltip: Icicles ignore blocks while falling above or at the player's height
		}

		ToxicFlaskPoisonousBreath: {
			Label: "[i:3105] Toxic Flask: Poisonous Breath"
			Tooltip:
				'''
				Poisonous clouds gain enhanced properties:

				• Inflict a random damage-over-time debuff on enemies
				• Lifetime slightly increased
				• Can hit enemies 4 additional times
				• Cloud size increased by 50%
				'''
		}

		VampireKnivesBloodlust: {
			Label: "[i:1569] Vampire Knives: Bloodlust"
			Tooltip:
				'''
				Vampire Knives gain bloodlusting properties:

				• Inflict the Bloodlust debuff on enemies
				• Striking Bloodlusted enemies slightly heals the player
				• Increases Vampire Knives critical strike chance by 8%
				'''
		}

		##MISC Config
		ConsumabledBossItems: {
			Label: "[i:560] Boss items: Consumabled"
			Tooltip:
				'''
				Boss summoning items are no longer consumable. 
				Their price and crafting has been changed.
				'''
		}

		ClentaminatorSpeedBoost: {
			Label: "[i:779] Clentaminator: Speed boost"
			Tooltip:
				'''
				Increases the range of the Clentaminator
				Solutions are consumed faster and cost more
				'''
		}

		TownNPCsInvincible: {
			Label: Town NPCs: Invincible
			Tooltip: Town NPCs don't take Damage
		}

		TownNPCsSpecialShop: {
			Label: Town NPCs: Special shop
			Tooltip: Adds special items (including those dropped from Town NPCs) to the shop
		}

		ConsumabledBossItemsGensokyo: {
			Tooltip:
				'''
				[c/EE0000:"Gensokyo Mod"]
				Boss summoning items are no longer consumable. 
				Their price and crafting has been changed.
				'''
			Label: "[i:560] Gensokyo boss summon: Consumabled"
		}

		ConsumabledBossItemsThorium: {
			Tooltip:
				'''
				[c/00FFFF:"Thorium Mod"]
				Boss summoning items are no longer consumable. 
				Their price and crafting has been changed.
				'''
			Label: "[i:560] Thorium boss summon: Consumabled"
		}
	}

	ModContentConfig: {
		DisplayName: "[WoS] Mod Content Config"
		Headers.NPCs: NPCs

		HunterAlwaysSellsMaterials: {
			Label: Hunter: Always sells resources
			Tooltip: It affects whether the Hunter will trade materials from the hunt depending on the Zone or not
		}
	}
}

