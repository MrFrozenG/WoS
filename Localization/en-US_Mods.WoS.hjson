###CONFIGS###
Configs: {
	ContentConfig: {
		DisplayName: Content config
		Headers.Familiars: "[Familiars]"

		FamiliarsSystem: {
			Label: is Familiars enabled
			Tooltip: Affects the presence of Familiars in the game.
		}
	}

	VanilaConfig: {
		DisplayName: Vanila content rework

		Headers: {
			NPCs: "[NPCs]"
			Weapons: "[Weapons]"
			Misc: "[Misc]"
		}

		ReworkPhoenixBlaster: {
			Label: Phoenix blaster rework
			Tooltip: If enabled, it modifies the Phoenix Blaster, adding the ability to auto-fire, and also adds Phoenix Energy mechanics: Every 4 shots allow you to use an alternative attack.
		}

		ReworkVolcano: {
			Label: Volcano rework
			Tooltip: If enabled, it modifies the Volcano sword, affecting damage as well as the method of attack.
		}

		ReworkSpears: {
			Label: Spears rework
			Tooltip: if enabled, it modifies some vanila spears
		}

		ConfigExplosivesAutouse: {
			Label: Explosives: Auto-use
			Tooltip: If enabled, it allows to use an auto-attack for Explosives.
		}

		ConfigExplosivesThrowSpeed: {
			Label: Explosives: Throwing speed
			Tooltip: Changes the speed of explosives. Default: 25
		}

		AlternativeTexturesVanilaKeys: {
			Label: Alternative Textures for vanila keys
			Tooltip: ""
		}

		InvincibleTownNPCS: {
			Label: NPC: Town-NPCs are Invincible
			Tooltip:
				'''
				Town NPCs don't take Damage
				If a weapon should drop from a Town NPC at death, it will be in the NPC shop.
				'''
		}

		ReworkSummonItems: {
			Label: Boss summons Rework
			Tooltip:
				'''
				Boss summoning items are no longer consumable. 
				Their price and crafting has been changed.
				'''
		}

		ReworkClentaminator: {
			Label: Clentaminator Rework
			Tooltip:
				'''
				Increases the range of the Clentaminator
				Solutions are consumed faster and cost more
				'''
		}

		ReworkSummonMimics: {
			Label: Big mimics summons rework
			Tooltip:
				'''
				Keys for summoning Mimics are no longer consumable. 
				Use the Key near the empty chest to summon the big mimic you need.
				'''
		}
	}
}

