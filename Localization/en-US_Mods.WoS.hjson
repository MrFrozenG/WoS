	RingofLivingFlames: {
		DisplayName: Ring of Living Flames
		Tooltip:
			'''
			Lava Bats, Hell bats and Lava Slimes become friendly
			Grants immunity to “On Fire!”, “Hellfire”, “Frostburn” and “Chilled” debuffs
			Reduces damage from touching lava
			Provides 7 seconds of immunity to lava
			Grants the Inferno effect while below 25% life

			Burn yesterday to ashes, and rise with flames for Tomorrow
			'''
	}

	RingofDivineFlames: {
		DisplayName: Ring of Divine Flames
		Tooltip:
			'''
			Lava Bats, Hell bats and Lava Slimes become friendly
			Grants immunity to “On Fire!”, “Hellfire”, “Frostburn”, “Chilled”, “Cursed Inferno” and "Shadow flame" debuffs
			Reduces damage from touching lava
			Provides 7 seconds of immunity to lava
			Grants the Inferno effect while below 35% life
